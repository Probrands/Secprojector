# Discord webhook URL for alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# SEC EDGAR requires a User-Agent with your name and email
SEC_USER_AGENT=YourName your@email.com

# How often to scan for new filings (in minutes)
SCAN_INTERVAL_MINUTES=10

# Minimum confidence score (1-10) to trigger a Discord alert
MIN_CONFIDENCE_SCORE=4

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Path to SQLite database file
DB_PATH=filings.db

# Port for the web server (Railway sets this automatically)
PORT=8000
